# ---------------------------------------------------------------------------
# Leave BOTH VITE_SUPABASE_* empty to use the local-Postgres dev adapter.
# Set them to point the same app at a real Supabase project.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Local verification only. Never bundled into the browser build.
# Admin connection (runs migrations, used by test scripts for assertions).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/winner_wheel

# The dev RPC middleware connects with THIS role, which then does
# `SET LOCAL ROLE anon` per transaction -- mirroring PostgREST exactly.
# Connecting as a superuser here would silently bypass RLS and make the
# local security verification meaningless.
DEV_RPC_DATABASE_URL=postgres://wheel_anon:wheel_anon@127.0.0.1:5432/winner_wheel

# Preinstalled Chromium. Never run `playwright install`.
PLAYWRIGHT_CHROMIUM=/opt/pw-browsers/chromium-1194/chrome-linux/chrome
